+ClassGroup _derive(ClassGroup base, String name, int count) {
+  final c = ClassGroup.fromJson({
+    ...base.toJson(),
+    'id': newId(),
+    'name': name,
+  });
+  for (final s in c.students.skip(count).toList()) {
+    c.students.remove(s);
+    c.purgeStudent(s.id);
+  }
+  return c;
+}
+
+Future<void> _maybeSetupScreenshot(AppState state) async {
+  final env = Platform.environment;
+  if (env['PDC_SHOT_DEMO'] != '1') return;
+  final en = env['PDC_SHOT_LOCALE'] == 'en';
+  state.themePreference = ThemePreference.light;
+  state.localePreference = en
+      ? LocalePreference.english
+      : LocalePreference.french;
+  state.tutorialSeen = true;
+  state.studentsViewMode = env['PDC_SHOT_VIEW'] == 'compact'
+      ? StudentsViewMode.compact
+      : StudentsViewMode.complete;
+  final raw = await rootBundle.loadString(demoClassAsset);
+  final base = ClassGroup.fromJson(jsonDecode(raw) as Map<String, dynamic>);
+  final names = en
+      ? ['Grade 6B', 'Grade 7A', 'Grade 9C']
+      : ['6ème B', '5ème A', '3ème C'];
+  base.name = names[0];
+  if (env['PDC_SHOT_LAYOUT'] == 'ilots') {
+    base.room = buildIlotsLayout(islandSize: 4, islandCount: 3, islandRows: 3);
+    base.assignment.clear();
+  }
+  if (env['PDC_SHOT_FORCE_VIOLATION'] == '1') {
+    final a = base.assignment;
+    final tmp = a['0,0'];
+    a['0,0'] = a['3,2']!;
+    a['3,2'] = tmp!;
+  }
+  state.classes = env['PDC_SHOT_TAB'] == 'home'
+      ? [base, _derive(base, names[1], 17), _derive(base, names[2], 12)]
+      : [base];
+}
+
